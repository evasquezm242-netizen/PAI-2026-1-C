<Window x:Class="Tragamonedas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tragamonedas"
        mc:Ignorable="d"
        Title="Tragamonedas" Height="450" Width="800">

    <Grid Margin="50,40,50,40">

        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="tblReloj" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="00:00:00" FontSize="50" FontWeight="Bold" Background="#FFDDEFD0" Padding="15,5,15,5"/>

        <Button x:Name="btnJugar" Grid.Row="1" Content="Iniciar Juego" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,5,10,5" FontSize="13" FontWeight="Bold" Click="btnJugar_Click"/>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtNumero1" Grid.Column="1" Width="80" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0,5"/>

            <TextBox x:Name="txtJugada2" Grid.Column="2" Width="80" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0,5"/>

            <TextBox x:Name="txtJugada3" Grid.Column="3" Width="80" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0,5"/>

        </Grid>

        <Label x:Name="lbResultadoJuego" Grid.Row="3" Content="PERDISTE" HorizontalAlignment="Center" VerticalAlignment="Center" Width="250" Background="#FFAFD4EC" FontWeight="Bold" FontSize="14"  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Visibility="Hidden"/>

    </Grid>
</Window>