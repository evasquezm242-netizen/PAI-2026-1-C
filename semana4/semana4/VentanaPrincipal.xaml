<Window x:Class="semana4.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:semana4"
        mc:Ignorable="d"
        Title="VentanaPrincipal" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Button Content="Mostrar Ventana ComboBox" Height="215" Click="Button_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <Button Content="Mostrar Ventana ListBox" Height="215" Click="Button_Click_1"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Button Content="Mostar Ventana ListView" Height="215" Click="Button_Click_2"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="1">
            <Button Content="Mostar Ventana Registro" Height="216" Click="Button_Click_3"/>
        </StackPanel>

    </Grid>
</Window>
