<Window x:Class="semana4.Registro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:semana4"
        mc:Ignorable="d"
        Title="Registro" Height="450" Width="800">
    <Grid>
        <Label Content="Apellidos" HorizontalAlignment="Left" Margin="61,31,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <TextBox x:Name="txtApellidos" HorizontalAlignment="Left" Margin="61,57,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="252"/>
        <Label Content="Nombres" HorizontalAlignment="Left" Margin="378,31,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <TextBox x:Name="txtNombres" HorizontalAlignment="Left" Margin="377,57,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="321"/>
        <Label Content="D.N.I" HorizontalAlignment="Left" Margin="61,80,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <TextBox x:Name="txtDNI" HorizontalAlignment="Left" Margin="61,106,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Dirección" HorizontalAlignment="Left" Margin="377,80,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.305,-2.002" FontWeight="Bold"/>
        <TextBox x:Name="txtDireccion" HorizontalAlignment="Left" Margin="377,106,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="274"/>
        <Label Content="Estado civil" HorizontalAlignment="Left" Margin="61,138,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <ComboBox x:Name="cmbEstadoCivil" HorizontalAlignment="Left" Margin="61,164,0,0" VerticalAlignment="Top" Width="120">
            <ComboBoxItem Content="Soltero"/>
            <ComboBoxItem Content="Casado"/>
        </ComboBox>
        <Button x:Name="btnGrabar" Content="Grabar" HorizontalAlignment="Left" Margin="349,160,0,0" VerticalAlignment="Top" Width="60" Click="btnGrabar_Click"/>
        <Button x:Name="btnNuevo" Content="Nuevo" HorizontalAlignment="Left" Margin="438,160,0,0" VerticalAlignment="Top" Width="66" RenderTransformOrigin="0.27,1.605" Click="btnNuevo_Click"/>
        <Button x:Name="btnEstadistica" Content="Estadistica" HorizontalAlignment="Left" Margin="531,160,0,0" VerticalAlignment="Top" Width="74" Click="btnEstadistica_Click"/>
        <Button x:Name="btnSalir" Content="Salir" HorizontalAlignment="Left" Margin="635,160,0,0" VerticalAlignment="Top" Width="47"/>
        <ListView x:Name="lvCliente" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="61,217,80,65" SelectionChanged="ListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Apellidos" DisplayMemberBinding="{Binding Apellidos}" Width="210"/>
                    <GridViewColumn Header="Nombres" DisplayMemberBinding="{Binding Nombres}" Width="210"/>
                    <GridViewColumn Header="Edad" DisplayMemberBinding="{Binding DNI}" Width="80"/>
                    <GridViewColumn Header="Direccion" DisplayMemberBinding="{Binding Direccion}" Width="180"/>
                    <GridViewColumn Header="Estado Civil" DisplayMemberBinding="{Binding Estado civil}" Width="180"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBox x:Name="txtSolteros" HorizontalAlignment="Left" Margin="141,383,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txtCasados" HorizontalAlignment="Left" Margin="471,383,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="76,385,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontWeight="Bold"><Run Language="es-pe" Text="Solteros"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="408,385,0,0" TextWrapping="Wrap" VerticalAlignment="Top" RenderTransformOrigin="1.336,1.324" FontWeight="Bold"><Run Language="es-pe" Text="Casados"/></TextBlock>

    </Grid>
</Window>
