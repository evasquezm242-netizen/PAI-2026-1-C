<Window x:Class="semana4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:semana4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="106*"/>
            <RowDefinition Height="111*"/>
        </Grid.RowDefinitions>
        <StackPanel Height="212" VerticalAlignment="Bottom">
            <ComboBox x:Name="cmbFrutas" Width="120" Margin="0,10,0,0">
                <ComboBoxItem Content="Pera"/>
                <ComboBoxItem Content="Fresa"/>
                <ComboBoxItem Content="Papaya"/>
                <ComboBoxItem Content="Piña"/>
            </ComboBox>
            <Button x:Name="btnMostrar" Content="Mostrar Seleccionado" Width="121" Margin="0,10,0,0" Click="btnMostrar_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Label Content="Nueva fruta" Width="80"/>
            <TextBox x:Name="txtNuevo" TextWrapping="Wrap" Width="116"/>
            <Button x:Name="btnAgregar" Content="Agregar" Width="86" Margin="0,10,0,0"/>
        </StackPanel>

    </Grid>
</Window>
