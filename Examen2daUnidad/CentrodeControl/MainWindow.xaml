<Window x:Class="CentrodeControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centro de Control de Pedidos"
        Height="500"
        Width="900"
        Loaded="Window_Loaded">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">

            <TextBlock Text="País:"
                       VerticalAlignment="Center"/>

            <ComboBox x:Name="cbxPais"
                      Width="180"
                      Margin="10,0,20,0"/>

            <Button x:Name="btnIniciar"
                    Content="Iniciar"
                    Width="100"
                    Margin="5"
                    Click="btnIniciar_Click"/>

            <Button x:Name="btnDetener"
                    Content="Detener"
                    Width="100"
                    Margin="5"
                    Click="btnDetener_Click"/>

        </StackPanel>

        <ListView x:Name="lvPedidos"
                  Grid.Row="1"
                  Margin="0,20,0,20">

            <ListView.View>

                <GridView>

                    <GridViewColumn Header="N° Orden"
                                    Width="100"
                                    DisplayMemberBinding="{Binding OrderID}"/>

                    <GridViewColumn Header="Cliente"
                                    Width="220"
                                    DisplayMemberBinding="{Binding Cliente}"/>

                    <GridViewColumn Header="Fecha Pedido"
                                    Width="150"
                                    DisplayMemberBinding="{Binding OrderDate}"/>

                    <GridViewColumn Header="Flete"
                                    Width="100"
                                    DisplayMemberBinding="{Binding Freight}"/>

                    <GridViewColumn Header="País"
                                    Width="150"
                                    DisplayMemberBinding="{Binding ShipCountry}"/>

                </GridView>

            </ListView.View>

        </ListView>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal">

            <TextBlock Text="Estado: "
                       FontWeight="Bold"/>

            <TextBlock x:Name="txtEstado"
                       Text="Detenido"
                       Margin="0,0,30,0"/>

            <TextBlock Text="Total pedidos: "
                       FontWeight="Bold"/>

            <TextBlock x:Name="txtTotal"
                       Text="0"
                       Margin="0,0,30,0"/>

            <TextBlock Text="Último refresco: "
                       FontWeight="Bold"/>

            <TextBlock x:Name="txtHora"
                       Text="-"/>

        </StackPanel>

    </Grid>

</Window>
